{
    "name": "kafyx-3/permission-gate",
    "description": "Lightweight Laravel Gate & Blade directive helper — zero config, zero assumptions. Define your own permissions.",
    "keywords": ["laravel", "role", "permission", "gate", "blade"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "kafyx-3",
            "homepage": "https://github.com/kafyx-3"
        }
    ],
    "require": {
    "php": "^8.1",
    "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kafyx3\\PermissionGate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kafyx3\\PermissionGate\\PermissionGateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
